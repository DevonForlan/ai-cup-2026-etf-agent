{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SubmissionReceipt",
 "type": "object",
 "required": [
  "trade_date",
  "team_id",
  "dplan_sha256",
  "submitted_at",
  "submission_method",
  "confirmed_by"
 ],
 "properties": {
  "trade_date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "team_id": {
   "type": "string",
   "minLength": 1
  },
  "dplan_sha256": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "submitted_at": {
   "type": "string"
  },
  "submission_method": {
   "enum": [
    "manual_web",
    "manual_email",
    "official_api",
    "other"
   ]
  },
  "official_receipt_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "official_status": {
   "enum": [
    "accepted",
    "rejected",
    "pending",
    "unknown"
   ]
  },
  "screenshot_reference": {
   "type": [
    "string",
    "null"
   ]
  },
  "confirmed_by": {
   "type": "string",
   "minLength": 1
  },
  "notes": {
   "type": [
    "string",
    "null"
   ]
  }
 },
 "additionalProperties": false
}